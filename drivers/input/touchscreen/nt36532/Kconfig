#
# Novatek NT36xxx touchscreen driver configuration
#
config TOUCHSCREEN_NT36532_HOSTDL_SPI
	bool "Novatek NT36532 host download SPI driver"
	depends on SPI && INPUT_TOUCHSCREEN && FW_LOADER
	depends on TOUCHSCREEN_XIAOMI_TOUCHFEATURE && TOUCHSCREEN_NEW_PEN_CONNECT_STRATEGY
	help
	  Say Y here if you have a Novatek NT36532 no flash touchscreen connected
	  to your system by SPI bus.

	  If unsure, say N.

config TOUCHSCREEN_SUPPORT_NEW_GAME_MODE
	bool "Touch support for the new game mode interface"
	depends on TOUCHSCREEN_NT36532_HOSTDL_SPI
	default n
	help
	  Enable the Xiaomi touch-feature controls used by the NT36532 driver.

config TOUCHSCREEN_NVT_DEBUG_FS
	bool "Novatek NT36532 debugfs interface"
	depends on TOUCHSCREEN_NT36532_HOSTDL_SPI
	default n
	help
	  Enable the Novatek touchscreen diagnostic debugfs files.
