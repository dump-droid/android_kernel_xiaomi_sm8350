# The shared Xiaomi QGKI fragment makes this provider a module. The in-tree
# camera flash path is built in and requires the provider built in as well.
CONFIG_LEDS_QTI_FLASH=y
CONFIG_QTI_BATTERY_CHARGER=y
CONFIG_MI_HARDWARE_ID=y
CONFIG_PINCTRL_KONA=y
CONFIG_MSM_GCC_KONA=y
CONFIG_MSM_DISPCC_KONA=y
CONFIG_MSM_CAMCC_KONA=y
CONFIG_MSM_GPUCC_KONA=y
CONFIG_MSM_VIDEOCC_KONA=y
CONFIG_MSM_DEBUGCC_KONA=y
CONFIG_MSM_NPUCC_KONA=y
CONFIG_SPMI_PMIC_CLKDIV=y
CONFIG_QCOM_KONA_LLCC=y
CONFIG_QCOM_LLCC_PERFMON=y
CONFIG_QCOM_POWER_SUPPLY=y
CONFIG_ONEWIRE_GPIO_PIPA=y
CONFIG_BATT_VERIFY_BY_DS28E16_PIPA=y
CONFIG_QPNP_SMB5=y
CONFIG_QPNP_SMB5_PIPA=y
CONFIG_QPNP_QNOVO5=y
CONFIG_QPNP_FG_GEN4_PIPA=y
CONFIG_HL6111R=y
CONFIG_FUDA_1665=y
CONFIG_BQ2597X_CHARGE_PUMP_PIPA=y
CONFIG_DUAL_BQ2597X=y
CONFIG_USB_PD_POLICY=y
CONFIG_QPNP_USB_PDPHY=y
CONFIG_BACKLIGHT_KTZ8866=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_NEW_PEN_CONNECT_STRATEGY=y
CONFIG_TOUCHSCREEN_SUPPORT_NEW_GAME_MODE=y
CONFIG_TOUCHSCREEN_NT36532_HOSTDL_SPI=y
CONFIG_KEYBOARD_NANO_8030_V2=y
CONFIG_INPUT_AW8697_HAPTIC=y
CONFIG_ARCH_KONA_PIPA=y
CONFIG_SOUNDWIRE=y
CONFIG_DEBUG_FS=y
CONFIG_TOUCHSCREEN_NVT_DEBUG_FS=y
# CONFIG_TOUCHSCREEN_NT36XXX is not set
CONFIG_EXTRA_FIRMWARE="novatek_nt36532_m82_fw_csot.bin novatek_nt36532_m82_fw_tm.bin novatek_nt36532_m82_mp_csot.bin novatek_nt36532_m82_mp_tm.bin"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"
